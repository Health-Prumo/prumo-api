{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Prumo: API local",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/local_server.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Prumo: evento HTTP API 2.0",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.invoke",
      "args": ["examples/evento-health.json"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
