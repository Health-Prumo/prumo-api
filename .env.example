# Copie para .env e ajuste. Nunca commite o .env com valores reais.

# Login: "local" aceita qualquer "Bearer local-<algo>" (só no desenvolvimento; bloqueado na Lambda).
# Na AWS deixe vazio: o API Gateway valida o JWT do Cognito.
PRUMO_AUTH=local

# IA: "mock" (padrão, sem custo) ou "bedrock" (Amazon Nova Micro pela API Converse).
PRUMO_IA=mock
PRUMO_MODELO_ID=amazon.nova-micro-v1:0

# Origens liberadas no CORS, separadas por vírgula.
PRUMO_ORIGENS=http://localhost:5173

# Banco: com PRUMO_TABELA usa o DynamoDB; sem ela, guarda em memória ou no arquivo abaixo.
# PRUMO_TABELA=prumo-dev-dados
PRUMO_ARQUIVO_LOCAL=.dados-locais.json

# Pesos da nota de energia (PROVISÓRIOS, todos 1 por padrão). JSON opcional:
# PRUMO_PESOS={"sono": 1, "atividade": 1, "agua": 1, "alimentacao": 1, "humor": 1, "tela": 1}

# Fuso usado para saber qual é "hoje" (Brasília = -3).
PRUMO_FUSO_HORAS=-3

# Porta do servidor local.
PRUMO_PORTA=8000
