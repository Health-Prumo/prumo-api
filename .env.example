# Copie para .env. Valores de ambiente já definidos têm precedência.
PRUMO_AMBIENTE=local
PRUMO_PORTA=8000
# Mantenha loopback na máquina. O Compose define 0.0.0.0 somente dentro do container.
PRUMO_HOST_LOCAL=127.0.0.1
PRUMO_ORIGEM_FRONT=http://localhost:5173
# Identidade fictícia fixada pelo servidor; nunca vem do corpo ou de headers do navegador.
PRUMO_USUARIO_LOCAL=usuario-demo
# Caminho relativo à raiz do repositório. Use somente dados fictícios neste protótipo.
PRUMO_BANCO_LOCAL=.local/prumo.sqlite3
# Somente mock está implementado. Outros valores interrompem a inicialização.
PRUMO_LLM_MODO=mock
